# Ignore generic data directories by default.
data/

# Keep the stock_triggers data folder visible so we can selectively track
# config/docs files while leaving generated artifacts to origin/GitHub Actions.
!stock_triggers/data/

# Generated trigger datasets and calibration artifacts.
stock_triggers/data/*.csv
stock_triggers/data/*.json

# Keep tracked configuration and documentation files under stock_triggers/data.
!stock_triggers/data/universe_tickers.txt
!stock_triggers/data/stock_universe/
stock_triggers/data/stock_universe/*.csv
!stock_triggers/data/stock_universe/README.md

# Python virtual environments
stockpy11/
.venv/

# Python cache files
__pycache__/
*/__pycache__/
*.pyc

# macOS Finder metadata
.DS_Store

# Local CA bundles (do not commit)
tgt-ca-bundle.crt

# Local secrets (do not commit)
secrets.yml
