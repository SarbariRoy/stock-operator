# Copy this file to secrets.yml and fill values.
# secrets.yml is git-ignored.

TELEGRAM_BOT_TOKEN: "your_bot_token_here"
TELEGRAM_CHAT_ID: "your_chat_id_here"

# Google login for Streamlit app
# For production on Streamlit Cloud, set the redirect URI in Google Cloud Console
# to your deployed app URL, for example:
# https://stock-operator-roy.streamlit.app/
GOOGLE_OAUTH_CLIENT_ID: "your_google_client_id.apps.googleusercontent.com"
GOOGLE_OAUTH_CLIENT_SECRET: "your_google_client_secret_here"
GOOGLE_OAUTH_REDIRECT_URI: "https://stock-operator-roy.streamlit.app/"
GOOGLE_AUTH_COOKIE_SECRET: "replace_with_a_long_random_secret"
# GOOGLE_AUTH_COOKIE_DAYS: "30"

# Optional: keep these empty to allow any Google account.
# ALLOWED_GOOGLE_EMAILS: "user1@example.com,user2@example.com"
# ALLOWED_GOOGLE_DOMAINS: "example.com"

# Owner-only admin page access.
# ADMIN_GOOGLE_EMAILS: "owner@example.com"
